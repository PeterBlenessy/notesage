# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
src-tauri/target
src-tauri/gen
src-tauri/binaries/llama-server-*
src-tauri/binaries/lib/

# Coverage reports
coverage/

# Playwright
test-results/
playwright-report/

# Real Tauri E2E perf-results.json — written by performance.test.ts
# (CI uploads as artifact; local runs leave a fresh copy).
perf-results.json

# Build outputs
*.dmg
*.app
*.deb
*.AppImage

# Notesage app runtime data — written when this repo is opened as a project
# in the running Notesage app (project.json, charts/, drawings/, comments/,
# research/ etc. are all under this directory).
.notesage/

# Runtime lockfile for the `/schedule` skill (session id + pid + timestamp)
.claude/scheduled_tasks.lock

# Transient git worktrees used by the implement-tasks skill for parallel agents
.claude/worktrees/

# Generated lockfiles for bundled-skill scripts (created by `npm install`
# when the skill runs locally; not part of the skill's source).
bundled-skills/**/scripts/package-lock.json
bundled-skills/**/scripts/node_modules/

# Generated pkg-config stubs for headless Linux cargo check
src-tauri/.pkg-config-stubs/

# Local env files with telemetry keys/DSN (see .env.example) — never commit
.env
.env.local
public/excalidraw-assets/
.dev-home/
content/site/
content/screenshots/

# Vendored Tauri Swift API, copied in by `tauri-plugin`'s build script for the
# iOS plugin crate's Swift Package to resolve `import Tauri`. Regenerated on
# every build and version-locked to the tauri crate — committing it would let a
# stale copy drift from the Rust side.
src-tauri/crates/*/.tauri/

# Speech baseline fixtures — third-party audio, reproducible via
# `pnpm fetch:speech-fixtures`. Never committed.
tests/fixtures/speech/
