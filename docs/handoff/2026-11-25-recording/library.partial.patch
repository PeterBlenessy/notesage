+    expect(options[0]).toEqual({ value: 'auto', label: 'Identifiera automatiskt' });
+    expect(new Set(options.map((o) => o.value)).size).toBe(SPEECH_LANGUAGES.length);
+    const labels = options.slice(1).map((o) => o.label);
