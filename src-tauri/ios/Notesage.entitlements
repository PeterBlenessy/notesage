<?xml version="1.0" encoding="UTF-8"?>
<!--
  App-target entitlements (reference). Merge into the generated
  src-tauri/gen/apple app target's .entitlements during the Mac wiring step.

  - App Group: shares the security-scoped library bookmark with the Share
    Extension (required).
  - iCloud Documents: recommended so `startDownloadingUbiquitousItem` /
    NSFileCoordinator behave for iCloud Drive items. (Security-scoped picker
    access itself works without it, but downloads are smoother with it.)
    Drop the iCloud keys if you choose not to enable the capability.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.notesage.app</string>
    </array>

    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.notesage.app</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.com.notesage.app</string>
    </array>
</dict>
</plist>
