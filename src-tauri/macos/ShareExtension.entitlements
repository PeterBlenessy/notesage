<?xml version="1.0" encoding="UTF-8"?>
<!--
  A macOS app extension is sandboxed even though the host app is not, which is
  the whole reason ShareLibraryAccess exists.

  Deliberately NO App Group. That would need an embedded provisioning profile
  the release pipeline does not produce; the extension holds its own
  security-scoped bookmark instead. See task #0.3.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Fetching the page to extract an article. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The library folder the user picks, and the bookmark that remembers it
         across launches. Without the app-scope bookmark entitlement the grant
         would survive only for the life of one share. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
