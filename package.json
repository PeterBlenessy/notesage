    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:test": "tauri dev --features e2e-testing",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e-real": "wdio run wdio.conf.ts",
