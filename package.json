{
  "name": "notesage",
  "private": true,
  "version": "0.26.0",
  "license": "MIT",
  "author": "Peter Blenessy",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm dlx tsx scripts/generate-changelog.ts && tsc && vite build",
    "generate-changelog": "pnpm dlx tsx scripts/generate-changelog.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:test": "tauri dev --features e2e-testing",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e-real": "wdio run wdio.conf.ts",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "coverage:check": "bash scripts/coverage-check.sh",
    "coverage:update-baseline": "vitest run --coverage && node scripts/update-coverage-baseline.js",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e-real-full": "./scripts/run-real-e2e.sh"
  },
  "dependencies": {
