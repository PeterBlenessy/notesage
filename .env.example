# Notesage build-time environment variables.
#
# Copy to `.env` for local experimentation, but note: telemetry is intended to
# ship in RELEASE (CI) builds only. Leaving these unset is the supported default
# for local/dev builds — a build with no keys compiles and runs with telemetry
# fully disabled (the Rust side uses `option_env!`, so a missing value is `None`
# → telemetry off, never a crash). Keep dev activity out of the data.
#
# In CI, these are passed from GitHub Actions repository secrets into the build
# env for release builds only (see `.github/workflows/release.yml`). The required
# secret names mirror the variable names below:
#   NOTESAGE_SENTRY_DSN, NOTESAGE_APTABASE_KEY

# Crash / error reporting — Sentry DSN (DSN-swappable to a self-hosted GlitchTip).
# Format: https://<public_key>@<host>/<project_id>
NOTESAGE_SENTRY_DSN=

# Usage analytics — Aptabase app key (e.g. A-EU-XXXXXXXXXX or A-US-XXXXXXXXXX).
NOTESAGE_APTABASE_KEY=
